<html>
    <head>
        <title>Nhúng video dưới dạng nút bấm (Play on Click)</title>
    </head>
    <body>
        <div style="position: relative; width: 560px; height: 315px; background: url('https://img.youtube.com/vi/MxpYSaXkRlw/maxresdefault.jpg') no-repeat center; background-size: cover; cursor: pointer;" onclick="loadVideo(this)">
            <button style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: 10px 20px; background: rgba(0, 0, 0, 0.5); color: white; border: none; cursor: pointer;">Play</button>
        </div>
        <script>
        function loadVideo(element) {
            element.innerHTML = `
                <iframe width="560" height="315" 
                        src="https://www.youtube.com/embed/MxpYSaXkRlw?si=JU1FchCZOfTZHVE1" 
                        frameborder="0" allow="autoplay; encrypted-media" allowfullscreen>
                </iframe>`;
        }
        </script>
    </body>
</html>


